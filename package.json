{
  "name": "gxzs-harness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "check": "pnpm check:syntax && pnpm test && pnpm test:simulator && pnpm check:plugin",
    "test:simulator": "node --test scripts/soak/simulator.check.mjs",
    "check:syntax": "node scripts/check-syntax.mjs",
    "check:plugin": "node scripts/check-plugin.mjs",
    "check:config": "node scripts/check-config.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "3.2.4",
    "immer": "10.1.1",
    "vitest": "3.2.4",
    "zustand": "4.5.7"
  }
}
